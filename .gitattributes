# Normalize all text files to LF in the repo and working tree.
# (Vivado write_bd_tcl emits CRLF; this keeps line endings uniform and
#  fixes the "commit CRLF" warning + grep/diff weirdness on .tcl files.)
* text=auto eol=lf

# Binary files — never apply EOL conversion.
*.png binary
*.pdf binary
*.npy binary
*.zip binary
*.bit binary
*.xsa binary
*.dcp binary
